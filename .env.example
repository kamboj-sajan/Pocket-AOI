# Copy to .env and fill in. Never commit .env.

# Muse Glimmer backend: any OpenAI-compatible endpoint (AGENTS.md section 2).
# Hosted, fastest start:
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=meta/muse-glimmer-30b
LLM_API_KEY=

# Free on Kaggle: run notebooks/serve_glimmer_kaggle.ipynb, which prints these three lines to use instead:
# LLM_BASE_URL=https://<your link>.trycloudflare.com/v1
# LLM_MODEL=muse-glimmer-30b-ud-q4
# LLM_API_KEY=<the key it prints>

# Optional. Overrides models.sam in configs/default.yaml. Keep unsloth/sam3.1:
# facebook/sam3.1 does not load in Sam3Model, even with access granted.
# SAM_MODEL_ID=unsloth/sam3.1

# Optional. Raises the Hugging Face download rate limit.
# HF_TOKEN=

# Optional. A free Roboflow key, only for downloading the reversed-part photos (eval/fetch_roboflow_pcba.py).
# ROBOFLOW_API_KEY=
