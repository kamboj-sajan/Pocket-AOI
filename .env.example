# Copy to .env and fill in. Never commit .env.

# Muse Glimmer backend: any OpenAI-compatible endpoint (AGENTS.md section 2).
# Hosted, fastest start:
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=meta/muse-glimmer-30b
LLM_API_KEY=

# Self-hosted on Kaggle with llama-server:
# LLM_BASE_URL=http://localhost:8080/v1
# LLM_MODEL=muse-glimmer-30b
# LLM_API_KEY=none

# Optional. Overrides models.sam in configs/default.yaml.
# SAM_MODEL_ID=unsloth/sam3.1

# Only needed for a gated Hugging Face repo such as facebook/sam3.1.
# HF_TOKEN=
